page {
  --brand: #ff6b6b;
  --brand-dark: #e94f55;
  --ink: #302a2a;
  --muted: #8d8581;
  --paper: #fff8f3;
  --card: #ffffff;
  --line: #f1e4dc;
  background: var(--paper);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 44rpx 8rpx 28rpx;
}

.hero-title {
  display: block;
  font-size: 52rpx;
  line-height: 1.2;
  font-weight: 800;
}

.hero-subtitle {
  display: block;
  margin-top: 16rpx;
  color: var(--muted);
  line-height: 1.65;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(93, 62, 48, 0.06);
}

.row {
  display: flex;
  align-items: center;
}

.between {
  justify-content: space-between;
}

.grow {
  flex: 1;
  min-width: 0;
}

.muted {
  color: var(--muted);
}

.small {
  font-size: 24rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.section-title {
  display: block;
  margin: 30rpx 0 18rpx;
  font-size: 32rpx;
  font-weight: 700;
}

.input,
.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}

.textarea {
  min-height: 180rpx;
}

.label {
  display: block;
  margin-top: 22rpx;
  color: #5e5652;
  font-size: 25rpx;
  font-weight: 600;
}

button {
  margin: 0;
}

.primary,
.secondary,
.danger,
.ghost {
  min-height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  line-height: 80rpx;
}

.primary {
  background: var(--brand);
  color: #fff;
  font-weight: 700;
}

.secondary {
  background: #fff0ea;
  color: var(--brand-dark);
}

.danger {
  background: #fff0f0;
  color: #cb3434;
}

.ghost {
  background: #fff;
  color: #5f5652;
  border: 1rpx solid var(--line);
}

.mini {
  min-height: 58rpx;
  padding: 0 20rpx;
  font-size: 24rpx;
  line-height: 58rpx;
}

.button-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.button-row button {
  flex: 1;
}

.price {
  color: var(--brand-dark);
  font-size: 34rpx;
  font-weight: 800;
}

.price::before {
  content: "♥ ";
  font-size: 22rpx;
}

.badge {
  display: inline-flex;
  padding: 8rpx 16rpx;
  background: #fff0ea;
  color: var(--brand-dark);
  border-radius: 999rpx;
  font-size: 22rpx;
}

.empty {
  padding: 100rpx 30rpx;
  color: var(--muted);
  text-align: center;
}

.fixed-bar {
  position: fixed;
  z-index: 10;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid var(--line);
}

.fixed-bar .primary {
  flex: 1;
}

.cover {
  flex: none;
  width: 144rpx;
  height: 144rpx;
  margin-right: 22rpx;
  background: #f8ece5;
  border-radius: 22rpx;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #cfaaa0;
  font-size: 48rpx;
}
