<view class="page">
  <view class="hero compact">
    <text class="hero-title">老板，来新单啦</text>
    <text class="hero-subtitle">接单后按实际进度更新，她会在微信里看到。</text>
  </view>

  <scroll-view class="filters" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="value" class="filter {{selectedFilter === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="chooseFilter">{{item.label}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{!loading && orders.length === 0}}" class="empty">这里暂时没有订单。</view>

  <view wx:for="{{orders}}" wx:key="id" class="card order" data-id="{{item.id}}" bindtap="open">
    <view class="row between">
      <view>
        <text class="title">{{item.customerName}}</text>
        <text class="muted small order-no">{{item.orderNo}}</text>
      </view>
      <text class="badge">{{item.statusLabel}}</text>
    </view>
    <text class="summary">{{item.summary}}</text>
    <text wx:if="{{item.remark}}" class="remark">“{{item.remark}}”</text>
    <view class="row between meta">
      <text class="muted small">{{item.displayTime}}</text>
      <text class="price">{{item.displayTotal}}</text>
    </view>
  </view>

  <role-nav role="merchant" active="orders" />
</view>
