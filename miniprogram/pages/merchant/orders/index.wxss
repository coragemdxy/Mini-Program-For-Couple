.compact {
  padding-top: 20rpx;
}

.filters {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 14rpx;
}

.filter {
  padding: 15rpx 28rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
}

.filter.active {
  background: var(--ink);
  color: #fff;
}

.order-no {
  display: block;
  margin-top: 7rpx;
}

.summary,
.remark {
  display: block;
  margin-top: 20rpx;
  line-height: 1.55;
}

.remark {
  padding: 16rpx;
  background: #fff8f3;
  color: #785c50;
  border-radius: 15rpx;
}

.meta {
  margin-top: 22rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}
