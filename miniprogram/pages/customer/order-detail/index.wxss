.success {
  padding: 36rpx 0 50rpx;
  text-align: center;
}

.success-icon {
  display: block;
  color: var(--brand);
  font-size: 70rpx;
}

.number,
.time,
.remark,
.detail,
.event-message {
  display: block;
  margin-top: 10rpx;
}

.line {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.total-line {
  padding-top: 24rpx;
}

.event {
  display: flex;
  gap: 18rpx;
  padding-top: 24rpx;
}

.dot {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  background: var(--brand);
  border: 8rpx solid #ffe6df;
  border-radius: 50%;
}
