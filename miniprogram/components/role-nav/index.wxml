<view class="nav-shell">
  <view wx:for="{{items}}" wx:key="key" class="nav-item {{item.active ? 'active' : ''}}" data-key="{{item.key}}" data-url="{{item.url}}" bindtap="navigate">
    <view class="icon-wrap">
      <text class="nav-icon">{{item.icon}}</text>
      <text wx:if="{{role === 'customer' && item.key === 'cart' && cartCount > 0}}" class="cart-badge">{{cartCount > 99 ? '99+' : cartCount}}</text>
    </view>
    <text class="nav-label">{{item.label}}</text>
  </view>
</view>
